# DevLens Environment Configuration Template
# Copy this file to .env and fill in your actual values

# Backend Server
PORT=8080
ENVIRONMENT=development

# CORS - Allowed Origins (comma-separated, no spaces after commas)
# For development: http://localhost:3000
# For production: https://devlens.vercel.app, https://yourdomain.com
ALLOWED_ORIGINS=http://localhost:3000

# Database (Neon/Supabase PostgreSQL)
DATABASE_URL=postgresql://username:password@host:5432/devlens_db
DB_HOST=localhost
DB_PORT=5432
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=devlens_db
DB_SSL_MODE=disable

# GitHub API
GITHUB_TOKEN=your_github_personal_access_token_here
GITHUB_API_URL=https://api.github.com

# AI Integration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_FRONTEND_URL=http://localhost:3000

# Deployment
FLY_API_TOKEN=your_fly_io_token_here
RENDER_API_KEY=your_render_api_key_here
VERCEL_TOKEN=your_vercel_token_here
VERCEL_ORG_ID=your_vercel_org_id_here
VERCEL_PROJECT_ID=your_vercel_project_id_here

# Security
JWT_SECRET=your_jwt_secret_key_here

# Storage
TEMP_DIR=/tmp/devlens
MAX_REPO_SIZE_MB=500

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_MINUTES=15